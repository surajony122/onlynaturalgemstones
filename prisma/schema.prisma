// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  // Switched from sqlite to postgresql for the Render deployment — Render's
  // filesystem is ephemeral (wiped on every redeploy/restart), so a local
  // sqlite file would silently lose the shop's stored offline access token
  // on the next deploy. DATABASE_URL is provided automatically by Render
  // when a Postgres instance is attached to this service (see render.yaml).
  // Local dev can still point this at a local Postgres, or temporarily back
  // at "sqlite" + "file:dev.sqlite" if that's easier while developing.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Astro Advice / gem-recommendation lead — merged in from the standalone
// astro-lead-sync-app + Google Apps Script backend (see
// app/routes/proxy.astro-advice.jsx). Database is the source of truth;
// each row is also best-effort mirrored into the same Google Sheet the
// Apps Script version used to write to directly, via
// app/utils/googleSheets.server.js, so the existing manual-review habit
// (open the Sheet) keeps working without needing a new admin screen yet.
model AstroLead {
  id              String   @id @default(cuid())
  trackingId      String   @unique
  // Which store this lead belongs to — lets the public /track routes
  // (no login context, hit directly by mail clients) resolve the right
  // shop's Settings row for Sheet mirroring, by looking up the lead's
  // own shop via its trackingId. Not enforced NOT NULL for backward
  // compatibility with rows written before this column existed.
  shop            String?
  createdAt       DateTime @default(now())
  name            String?
  email           String?
  phone           String?
  gender          String?
  purpose         String?
  bodyWeightKg    Float?
  dob             String?
  tob             String?
  placeOfBirth    String?
  ascendant       String?
  moonsign        String?
  sunsign         String?
  lifeStoneGem    String?
  lifeStonePlanet String?
  beneficStoneGem String?
  luckyStoneGem   String?
  // Full recommendation object (life/benefic/lucky, each with
  // planet/gem/collection/substitute/weightCarat/wearMetal/wearFinger/
  // wearDay) — same shape buildRecommendations() in the old Code.gs
  // produced, stored as JSON so the results-page link and email body can
  // both be rebuilt from this one row without re-deriving anything.
  recommendation  Json?
  calculationOk   Boolean  @default(true)
  astroError      String?
  shopifySyncStatus String?
  emailSendStatus   String?
  // Result of the WhatsApp send via Interakt (see
  // app/utils/interakt.server.js) — same "OK: ..." / "skipped: ..." /
  // "FAILED: ..." shape as emailSendStatus, shown as its own status pill
  // on the Astro Leads dashboard. Null/empty means it was never
  // attempted (e.g. no phone on the lead, or Interakt not configured yet).
  whatsappSendStatus String?
  // When the automatic "first" WhatsApp send was attempted (set by
  // handleAstroAdviceSubmission, success or failure — either way that's
  // when the clock starts for the follow-up window). Null means either
  // no phone was on the lead, or this row predates the follow-up feature.
  whatsappFirstSentAt    DateTime?
  // Result + timestamp of the automatic follow-up reminder (same
  // template, resent once, after AppSettings.whatsappIntervalValue/Unit
  // has passed since whatsappFirstSentAt) — see
  // app/utils/whatsappQueue.server.js. Null whatsappFollowUpSentAt means
  // not sent yet (still pending, or follow-ups are turned off).
  whatsappFollowUpStatus String?
  whatsappFollowUpSentAt DateTime?
  // Free-text internal note, editable by staff on the Astro Leads
  // dashboard — never shown to the customer, purely for team use
  // (e.g. "called, not interested" / "followed up via WhatsApp").
  notes             String?
}

// One row per sent/opened/clicked event for a given lead's email — see
// app/routes/track.$type.jsx (opened/clicked) and
// app/utils/astroAdvice.server.js (sent). Kept as its own append-only
// table (not columns on AstroLead) since one lead can have many events.
// Deliberately NOT a foreign key to AstroLead.trackingId — tracking
// pixels/links are hit directly by external mail clients (replays,
// cached fetches, forwarded emails), so a stale or malformed id must log
// harmlessly rather than have a FK constraint reject the insert.
// Cross-reference by trackingId manually when looking at the data.
model EmailEvent {
  id         String   @id @default(cuid())
  trackingId String
  event      String // "sent" | "opened" | "clicked"
  detail     String? // recipient email (sent) or destination URL (clicked)
  createdAt  DateTime @default(now())

  @@index([trackingId])
}

// One row per Interakt webhook delivery/read status event for a WhatsApp
// template message — see app/routes/public.interakt-webhook.jsx and
// app/routes/app.whatsapp-events.jsx. Interakt has no "fetch campaign
// stats" API (confirmed via their docs) — the ONLY way to get real
// delivered/read status into our own app is to receive their webhook and
// log it ourselves, same reasoning EmailEvent already established for
// email open/click tracking. Deliberately NOT a foreign key to
// AstroLead.trackingId, same reasoning as EmailEvent — a malformed/stale
// trackingId (parsed from Interakt's callback_data) must log harmlessly
// rather than reject the insert.
model WhatsAppMessageEvent {
  id            String   @id @default(cuid())
  // Interakt's own message id (data.message.id in the webhook payload) —
  // unique per actual API send, so multiple events (Sent, then
  // Delivered, then Read) for the SAME message share this.
  messageId     String
  // Parsed from data.message.meta_data.source_data.callback_data (we set
  // this to "astro-<trackingId>" on every send — see
  // interakt.server.js's buildGemRecommendationTemplatePayload) — our own
  // correlation key back to the AstroLead this message belongs to. Null
  // for non-gem-recommendation sends (e.g. order-processing, whose
  // callbackData is "order-<orderNumber>" instead — see callbackData
  // below for those).
  trackingId    String?
  // Raw data.message.meta_data.source_data.callback_data, unparsed —
  // kept alongside the parsed trackingId so the dashboard can also
  // recognize OTHER send types by their own callbackData prefix (e.g.
  // "order-<orderNumber>" from sendOrderProcessingWhatsApp) without
  // needing a new column per send type as more get added later.
  callbackData  String?
  phone         String?
  // "Sent" | "Delivered" | "Read" | "Failed" — Interakt's own
  // data.message.message_status value, used as-is rather than remapped.
  status        String
  failureReason String?
  // The webhook "type" field verbatim (message_api_sent/_delivered/
  // _read/_failed) — kept alongside `status` since it's what actually
  // distinguishes the event type when message_status string casing/
  // wording ever varies.
  eventType     String
  receivedAt    DateTime @default(now())

  @@index([trackingId])
  @@index([messageId])
}

// One row per order that's had its "order processing" WhatsApp
// notification sent — see app/routes/webhooks.orders.updated.jsx.
// orderId is unique specifically so a second orders/updated event for
// the same order (which WILL keep firing on every later change too,
// e.g. eventually being marked fulfilled) can check "have we already
// notified for this order" and skip re-sending, rather than messaging
// the customer again on every subsequent update.
model OrderProcessingNotification {
  id         String   @id @default(cuid())
  shop       String?
  orderId    String // Shopify numeric order id — no longer unique alone,
  // see triggerKey below.
  // Identifies WHICH occurrence this notification was for, so a genuinely
  // new occurrence can notify again instead of being blocked forever by
  // an earlier one. "tag" for the tag-based trigger (a tag has no
  // natural per-occurrence identity, so that trigger still only ever
  // fires once per order) — or the ISO timestamp of the specific order-
  // timeline event for the "in progress" events-based trigger, so each
  // distinct "marked as in progress" action gets its own notification
  // even if it happens more than once on the same order (per explicit
  // user request — see webhooks.orders.updated.jsx).
  triggerKey String   @default("tag")
  orderName  String? // e.g. "#1001", customer-facing
  phone      String?
  status     String? // same "OK: .../FAILED: ..." shape as elsewhere
  notifiedAt DateTime @default(now())

  @@unique([orderId, triggerKey])
}

// Append-only, unconditional log of every orders/updated webhook receipt
// — written as the VERY FIRST thing in webhooks.orders.updated.jsx,
// before the "already notified" check or any GraphQL call. Exists
// purely to answer one question definitively: is Shopify even calling
// our endpoint for real order events? (An empty OrderProcessingNotification
// list is ambiguous — "webhook never fired" and "webhook fired but found
// nothing to do" look identical there. This table isn't ambiguous.)
model WebhookReceiptLog {
  id         String   @id @default(cuid())
  topic      String
  shop       String?
  orderId    String?
  // Filled in AFTER the unconditional create (via a follow-up update) as
  // processing proceeds — what fulfillment status was found, whether the
  // "already notified" skip applied, GraphQL errors, etc. Null means
  // processing never got past the initial receipt (crashed before the
  // first update) — itself a useful signal.
  detail     String?
  receivedAt DateTime @default(now())
}

// Per-shop configuration editable from the app's own Settings page
// (app/routes/app.settings.jsx) — Gmail sending credentials and the
// Google Sheets mirror target, previously only settable as Render
// environment variables. A row here, when present, takes priority over
// the matching env var (see app/utils/appSettings.server.js) — so
// existing env vars keep working as a fallback/default even before
// anyone visits the Settings page.
//
// SECURITY NOTE: these are stored in plaintext in the database (not
// encrypted at rest) — protected only by Postgres's own access control
// and the fact that only Shopify-authenticated staff of this store can
// reach the Settings page at all. Acceptable for a small internal tool;
// revisit (e.g. encrypt gmailAppPassword/googleServiceAccountPrivateKey
// with a key held only in an env var) if this ever needs a stronger bar.
model AppSettings {
  id                             String   @id @default(cuid())
  shop                           String   @unique
  gmailUser                      String?
  gmailAppPassword               String?
  googleServiceAccountEmail      String?
  googleServiceAccountPrivateKey String?
  astroLeadsSpreadsheetId        String?
  // Alternative to the service-account approach above — a tiny Google
  // Apps Script Web App URL (deployed under the merchant's own Google
  // account, bound to the target Sheet, no service account/key needed
  // at all). Added because this store's Google Workspace org policy
  // blocks service account key creation entirely
  // (iam.managed.disableServiceAccountKeyCreation) with no override
  // available to this user — the relay sidesteps that requirement
  // completely. See app/utils/googleSheets.server.js: if this is set,
  // it's tried first; the service-account fields above are only used as
  // a fallback if this is blank.
  sheetsRelayUrl                 String?
  sheetsRelaySecret              String?
  // Hours to wait after a customer's LATEST wishlist change before
  // emailing them — each new change pushes this out again (classic
  // abandoned-wishlist debounce), so someone actively adding items all
  // day gets one email once they've gone quiet, not one per add. See
  // app/utils/wishlist.server.js's processDueWishlistEmails. Stored as
  // a string (like the rest of this model's settings-page-editable
  // fields) and parsed with a default fallback where it's used.
  wishlistEmailIntervalHours     String?
  // WhatsApp sending via Interakt's Send Template API — see
  // app/utils/interakt.server.js. interaktApiKey is the Basic-Auth
  // secret from Interakt → Settings → Developer Setting → Secret Key.
  // interaktTemplateName is the pre-approved WhatsApp template's exact
  // code name (Interakt/Meta require the template to exist and be
  // approved before any send will succeed) — defaults to
  // "gem_recommendation" if left blank, see DEFAULT_INTERAKT_TEMPLATE_NAME.
  interaktApiKey                 String?
  interaktTemplateName           String?
  // Second, separate WhatsApp template — sent when an order's
  // fulfillment order status is first seen as IN_PROGRESS (staff manually
  // marks an item "as in progress" in the order's fulfillment card, a
  // distinct step before actual fulfillment) — see
  // app/routes/webhooks.orders.updated.jsx. Defaults to "order_inprocess"
  // if left blank — see DEFAULT_INTERAKT_ORDER_TEMPLATE_NAME.
  interaktOrderTemplateName      String?
  // Third, separate WhatsApp template — the wishlist reminder (see
  // sendWishlistWhatsApp in interakt.server.js), sent alongside the
  // wishlist reminder email on the same debounced/interval schedule —
  // used when this Settings page field is left blank. Defaults to
  // "wishlist_reminder" if left blank, see
  // DEFAULT_INTERAKT_WISHLIST_TEMPLATE_NAME. Column added after the
  // fact — this field was already referenced throughout
  // appSettings.server.js/app.settings.jsx but had no matching column,
  // which made every Settings-page save fail with a Prisma "Unknown
  // argument" error (confirmed live) regardless of what was actually
  // being changed.
  interaktWishlistTemplateName  String?
  // Tag name that, when present on an order, triggers the order-
  // processing WhatsApp send (see webhooks.orders.updated.jsx) — added
  // after confirming live that none of Shopify's own fulfillment-status
  // fields (displayFulfillmentStatus, fulfillmentOrders[].status,
  // fulfillmentOrders[].requestStatus) reliably reflected the "In
  // progress" badge shown in Admin for this store's actual orders. A
  // merchant-applied tag is explicit and fully reliable by comparison.
  // Defaults to "processing" if left blank — see
  // DEFAULT_ORDER_PROCESSING_TRIGGER_TAG.
  orderProcessingTriggerTag      String?
  // Interakt "API Campaign" — groups every WhatsApp send under one
  // campaign so sent/delivered/read stats show up in Interakt's own
  // dashboard (Notifications -> API Campaigns) instead of only being
  // visible one contact/conversation at a time. Created automatically
  // (see app/utils/interakt.server.js's getOrCreateInteraktCampaignId)
  // the first time a send happens after this is blank — interaktCampaignId
  // is the UUID Interakt returns, interaktCampaignTemplateName records
  // which template it was created for, so a later template-name change
  // (e.g. switching to the Utility-category version) triggers creating a
  // fresh campaign rather than silently tagging sends under a campaign
  // that no longer matches the template actually being sent.
  interaktCampaignId             String?
  interaktCampaignTemplateName   String?
  // Secret entered when registering our webhook URL in Interakt ->
  // Developer Settings -> Webhooks (their side generates/you choose it,
  // both sides must have the same value) — used to verify the
  // Interakt-Signature header (HMAC-SHA256 of the raw request body) on
  // every incoming webhook, so a request claiming to be Interakt can't be
  // spoofed. See app/routes/public.interakt-webhook.jsx.
  interaktWebhookSecret          String?
  // WhatsApp send pacing — spaces out ALL outgoing gem-recommendation
  // WhatsApp messages (across every lead, not per-customer) by at least
  // this long, instead of firing one the instant each lead submits.
  // Mitigates Meta's error 131049 ("didn't deliver due to their per-user
  // limit on marketing notifications") that a brand-new WhatsApp Business
  // sender number tends to trip when bursting messages — pacing sends
  // gradually is a widely-recommended way to build up sender quality
  // rating. "0" (or blank) means the feature is off: sends happen
  // immediately, same as before this existed. See
  // app/utils/whatsappQueue.server.js for the actual queue/pacing logic,
  // and cron.whatsapp-queue.jsx for what advances the queue.
  whatsappIntervalValue          String?
  whatsappIntervalUnit           String? // "minutes" | "hours" | "days"
  // When the last queued WhatsApp send actually went out (any shop-wide
  // send, success or failure — a failed attempt still "used" its pacing
  // slot so a permanently-broken lead can't block the queue forever).
  // Null means none sent yet under pacing.
  whatsappLastSentAt             DateTime?
  // Google Places API key — used server-side only, by
  // proxy.places-autocomplete.jsx, to power the "Place of Birth"
  // autocomplete on the theme's Personalised Pooja form. Never sent to
  // the browser (the theme calls our proxy endpoint, which calls Google
  // itself and returns just the results) — unlike a typical client-side
  // Places integration, this key never needs a domain restriction for
  // security, though restricting it in Google Cloud Console is still
  // good practice. Blank means the endpoint falls back to the free
  // Photon/OpenStreetMap lookup instead (see
  // proxy.places-autocomplete.jsx for both paths).
  googlePlacesApiKey             String?
  updatedAt                      DateTime @updatedAt
}

// One row per wishlist email sent — mirrors AstroLead's shape but for
// the wishlist "here's what you saved" email (see
// app/routes/proxy.wishlist-sync.jsx). The wishlist's existing sync to
// Shopify (tag/note via the hidden native customer form in theme.liquid)
// is untouched — this is purely additive, just the email + tracking
// piece layered on top. EmailEvent rows (sent/opened/clicked) are shared
// with AstroLead, cross-referenced by trackingId the same way.
model WishlistLead {
  id              String   @id @default(cuid())
  trackingId      String   @unique
  shop            String?
  createdAt       DateTime @default(now())
  email           String?
  phone           String?
  // Product handles wishlisted at the moment this sync fired — the full
  // list, not a diff (matches how the client's own debounced sync works).
  productHandles  Json?
  // Resolved product details (title/image/price) at the moment this sync
  // fired — same data the email itself was built from, saved back here
  // so the dashboard can show real item details, not just handles/count,
  // without needing to re-fetch from Shopify (and stays accurate even if
  // a product's title/price/image changes or it's deleted later).
  products        Json?
  emailSendStatus String?
  // Result of the WhatsApp send via Interakt (see
  // sendWishlistWhatsApp in interakt.server.js) — same "OK: ..." /
  // "skipped: ..." / "FAILED: ..." shape as emailSendStatus, sent
  // alongside the email (same debounced/interval timing, not per-sync),
  // shown as its own status pill on the Wishlist Leads dashboard.
  whatsappSendStatus String?
  // Free-text internal note, editable by staff on the Wishlist Leads
  // dashboard — same purpose as AstroLead.notes.
  notes           String?
}
